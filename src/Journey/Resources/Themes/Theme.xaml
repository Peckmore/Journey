<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brushes -->
    <SolidColorBrush x:Key="JourneyActiveStepBackgroundBrush" Color="#FF557FF3" />
    <SolidColorBrush x:Key="JourneyActiveStepForegroundBrush" Color="#FFFEFEFE" />
    <SolidColorBrush x:Key="JourneyBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="JourneyHighlightBackgroundBrush" Color="#FF557FF3" />
    <SolidColorBrush x:Key="JourneyHighlightForegroundBrush" Color="#FFFEFEFE" />

    <!-- Fonts -->
    <FontFamily x:Key="RobotoRegular">
        pack://application:,,,/Journey;component/Resources/Fonts/Roboto-Regular.ttf#Roboto
    </FontFamily>

    <!-- Styles -->
    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource RobotoRegular}" />
    </Style>

</ResourceDictionary>