<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brushes -->

    <Color x:Key="ButtonBarColor">#FF232323</Color>
    <Color x:Key="ButtonBarBorderColor">#FF444444</Color>

    <Color x:Key="ControlHoverColor">#FF444444</Color>
    <Color x:Key="ControlNormalColor">Transparent</Color>
    <Color x:Key="ControlPressedColor">#FF333333</Color>

    <Color x:Key="HighlightColor">#FF557FF3</Color>
    <Color x:Key="HighlightTextColor">#FFFEFEFE</Color>

    <Color x:Key="LineColor">#FFCCCCCC</Color>

    <Color x:Key="JourneyStepBannerColor">#FF232323</Color>
    <Color x:Key="JourneyStepTextColor">#FFFEFEFE</Color>
    <Color x:Key="JourneyStepArchiveTextColor">#FFBBBBBB</Color>

    <!-- Images -->
    <BitmapImage x:Key="ResetViewImage" UriSource="pack://application:,,,/Journey;component/Resources/Images/Dark/reset_view.png" />
    <BitmapImage x:Key="ResetZoomImage" UriSource="pack://application:,,,/Journey;component/Resources/Images/Dark/reset_zoom.png"/>
    <BitmapImage x:Key="ZoomInImage" UriSource="pack://application:,,,/Journey;component/Resources/Images/Dark/zoom_in.png"/>
    <BitmapImage x:Key="ZoomOutImage" UriSource="pack://application:,,,/Journey;component/Resources/Images/Dark/zoom_out.png"/>

</ResourceDictionary>