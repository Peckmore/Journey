<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brushes -->
    <SolidColorBrush x:Key="ActiveBorderBrush" Color="#FF444444" />
    <SolidColorBrush x:Key="LineBrush" Color="#FFCCCCCC" />
    <SolidColorBrush x:Key="PressedBrush" Color="#FF333333" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFFEFEFE" />
    <SolidColorBrush x:Key="TextLightBrush" Color="#FFBBBBBB" />
    <SolidColorBrush x:Key="WindowBrush" Color="#FF232323" />

    <!-- Images -->
    <BitmapImage x:Key="ResetViewImage" UriSource="pack://application:,,,/Journey;component/Images/reset_view.dark.png" />
    <BitmapImage x:Key="ResetZoomImage" UriSource="pack://application:,,,/Journey;component/Images/reset_zoom.dark.png"/>
    <BitmapImage x:Key="ZoomInImage" UriSource="pack://application:,,,/Journey;component/Images/zoom_in.dark.png"/>
    <BitmapImage x:Key="ZoomOutImage" UriSource="pack://application:,,,/Journey;component/Images/zoom_out.dark.png"/>

</ResourceDictionary>