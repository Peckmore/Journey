<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors -->
    <Color x:Key="ActiveBorderColor">#FFCCCCCC</Color>
    <SolidColorBrush x:Key="ActiveBorderBrush" Color="{StaticResource ActiveBorderColor}" />

    <Color x:Key="LineColor">#FF777777</Color>
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />

    <Color x:Key="TextColor">#FF010101</Color>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />

    <Color x:Key="TextLightColor">#FF444444</Color>
    <SolidColorBrush x:Key="TextLightBrush" Color="{StaticResource TextLightColor}" />

    <Color x:Key="WindowColor">#FFF0F0F0</Color>
    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />

    <!-- Images -->
    <BitmapImage x:Key="ResetViewImage" UriSource="pack://application:,,,/Journey;component/Images/reset_view.light.png" />
    <BitmapImage x:Key="ResetZoomImage" UriSource="pack://application:,,,/Journey;component/Images/reset_zoom.light.png"/>
    <BitmapImage x:Key="ZoomInImage" UriSource="pack://application:,,,/Journey;component/Images/zoom_in.light.png"/>
    <BitmapImage x:Key="ZoomOutImage" UriSource="pack://application:,,,/Journey;component/Images/zoom_out.light.png"/>

</ResourceDictionary>