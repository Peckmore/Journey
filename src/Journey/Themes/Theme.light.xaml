<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors -->
    <SolidColorBrush x:Key="ActiveBorderBrush" Color="#FFCCCCCC" />
    <SolidColorBrush x:Key="LineBrush" Color="#FF777777" />
    <SolidColorBrush x:Key="PressedBrush" Color="#FFE0E0E0" />
    <SolidColorBrush x:Key="TextBrush" Color="#FF010101" />
    <SolidColorBrush x:Key="TextLightBrush" Color="#FF444444" />
    <SolidColorBrush x:Key="WindowBrush" Color="#FFF0F0F0" />

    <!-- Images -->
    <BitmapImage x:Key="ResetViewImage" UriSource="pack://application:,,,/Journey;component/Images/reset_view.light.png" />
    <BitmapImage x:Key="ResetZoomImage" UriSource="pack://application:,,,/Journey;component/Images/reset_zoom.light.png"/>
    <BitmapImage x:Key="ZoomInImage" UriSource="pack://application:,,,/Journey;component/Images/zoom_in.light.png"/>
    <BitmapImage x:Key="ZoomOutImage" UriSource="pack://application:,,,/Journey;component/Images/zoom_out.light.png"/>

</ResourceDictionary>