<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brushes -->
    <SolidColorBrush x:Key="JourneyActiveStepBackground" Color="#FF557FF3" />
    <SolidColorBrush x:Key="JourneyActiveStepForeground" Color="#FFFEFEFE" />
    <SolidColorBrush x:Key="JourneyBackground" Color="Transparent" />
    <SolidColorBrush x:Key="JourneyHighlightBackground" Color="#FF557FF3" />
    <SolidColorBrush x:Key="JourneyHighlightForeground" Color="#FFFEFEFE" />

    <!-- Fonts -->
    <FontFamily x:Key="RobotoRegular">
        pack://application:,,,/Journey;component/Fonts/Roboto-Regular.ttf#Roboto
    </FontFamily>

    <!-- Styles -->
    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource RobotoRegular}" />
    </Style>

</ResourceDictionary>