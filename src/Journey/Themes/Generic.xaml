<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Journey">

    <SolidColorBrush x:Key="JourneyHighlightColor" Color="DodgerBlue"/>

    <!-- Roboto FontFamily Resource -->
    <FontFamily x:Key="RobotoRegular">
        pack://application:,,,/Journey;component/Fonts/Roboto-Regular.ttf#Roboto
    </FontFamily>

    <!-- Set font for all Labels -->
    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource RobotoRegular}" />
    </Style>

</ResourceDictionary>