<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors -->
    <Color x:Key="JourneyBackgroundColor">Transparent</Color>
    <SolidColorBrush x:Key="JourneyBackgroundBrush" Color="{DynamicResource JourneyBackgroundColor}" />
    
    <Color x:Key="JourneyHighlightColor">#FF557FF3</Color>
    <SolidColorBrush x:Key="JourneyHighlightBrush" Color="{DynamicResource JourneyHighlightColor}" />

    <Color x:Key="JourneyHighlightTextColor">#FFFEFEFE</Color>
    <SolidColorBrush x:Key="JourneyHighlightTextBrush" Color="{DynamicResource JourneyHighlightTextColor}" />

    <!-- Fonts -->
    <FontFamily x:Key="RobotoRegular">
        pack://application:,,,/Journey;component/Fonts/Roboto-Regular.ttf#Roboto
    </FontFamily>

    <!-- Styles -->
    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource RobotoRegular}" />
    </Style>

</ResourceDictionary>