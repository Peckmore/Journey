<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors -->
    <SolidColorBrush x:Key="JourneyWebView2.ActiveStepBackground" Color="#FF557FF3" />
    <SolidColorBrush x:Key="JourneyWebView2.ActiveStepForeground" Color="#FFFEFEFE" />
    <SolidColorBrush x:Key="JourneyWebView2.Background" Color="Transparent" />
    <SolidColorBrush x:Key="JourneyWebView2.HighlightBackground" Color="#FF557FF3" />
    <SolidColorBrush x:Key="JourneyWebView2.HighlightForeground" Color="#FFFEFEFE" />

    <!-- Fonts -->
    <FontFamily x:Key="RobotoRegular">
        pack://application:,,,/Journey;component/Fonts/Roboto-Regular.ttf#Roboto
    </FontFamily>

    <!-- Styles -->
    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource RobotoRegular}" />
    </Style>

</ResourceDictionary>