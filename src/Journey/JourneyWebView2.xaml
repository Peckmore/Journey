<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 x:Class="Journey.JourneyWebView2"
 mc:Ignorable="d"
 d:DesignHeight="450"
 d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Journey;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="ContainerGrid"
          Background="Gray"
          ClipToBounds="True"
          MouseDown="ContainerGrid_MouseDown"
          PreviewMouseMove="ContainerGrid_PreviewMouseMove"
          PreviewMouseUp="ContainerGrid_PreviewMouseUp"
          PreviewMouseWheel="ContainerGrid_PreviewMouseWheel">

        <Grid x:Name="JourneyContainer"
              Visibility="Collapsed">

            <!-- Journey Canvas -->
            <!-- This is where "Journey Steps" are presented -->
            <Canvas x:Name="JourneyCanvas"
                    Background="Transparent">

                <Canvas.RenderTransform>
                    <TransformGroup>

                        <ScaleTransform ScaleX="{Binding JourneyZoomFactor, Mode=OneWay}"
                                        ScaleY="{Binding JourneyZoomFactor, Mode=OneWay}" />

                        <TranslateTransform x:Name="JourneyCanvasTranslateTransform"
                                            X="{Binding JourneyZoomCenterX, Mode=OneWay}"
                                            Y="{Binding JourneyZoomCenterY, Mode=OneWay}" />

                    </TransformGroup>
                </Canvas.RenderTransform>

            </Canvas>

            <Border x:Name="JourneyControls"
                    Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                    BorderThickness="0.5"
                    CornerRadius="10"
                    Height="40"
                    Opacity="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,25,0,0"
                    Padding="25,5,25,5">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="ZoomOutButton"
                            Click="ZoomOutButton_Click"
                            Grid.Column="0">
                        <Image Source="Images/zoom_out.png" />
                    </Button>

                    <Button x:Name="ZoomInButton"
                            Click="ZoomInButton_Click"
                            Grid.Column="1">
                        <Image Source="Images/zoom_in.png" />
                    </Button>

                    <Button x:Name="ResetZoomButton"
                            Click="ResetZoomButton_Click"
                            Grid.Column="2">
                        <Image Source="Images/reset_zoom.png" />
                    </Button>

                    <Button x:Name="CenterViewButton"
                            Click="CenterViewButton_Click"
                            Grid.Column="4">
                        <Image Source="Images/center_view.png" />
                    </Button>

                </Grid>

            </Border>

        </Grid>

        <!-- WebView -->
        <!-- This is the browser used for navigation. -->
        <wpf:WebView2 x:Name="WebView"
                      x:FieldModifier="public"
                      Margin="0"
                      DefaultBackgroundColor="White"/>

    </Grid>

</UserControl>