<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             x:Class="Journey.JourneyWebView2"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Journey;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="ContainerGrid"
          Background="Gray"
          ClipToBounds="True"
          PreviewMouseDown="ContainerGrid_PreviewMouseDown"
          PreviewMouseMove="ContainerGrid_PreviewMouseMove"
          PreviewMouseUp="ContainerGrid_PreviewMouseUp"
          PreviewMouseWheel="ContainerGrid_PreviewMouseWheel">

        <!-- Journey Canvas -->
        <!-- This is where "Journey Steps" are presented -->
        <Canvas x:Name="JourneyCanvas"
                Background="Transparent">

            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="{Binding JourneyZoomFactor}"
                                    ScaleY="{Binding JourneyZoomFactor}" />
                    <TranslateTransform x:Name="JourneyCanvasTranslateTransform"
                                        X="{Binding JourneyZoomCenterX}"
                                        Y="{Binding JourneyZoomCenterY}" />
                </TransformGroup>
            </Canvas.RenderTransform>

        </Canvas>

        <!-- WebView -->
        <!-- This is the browser used for navigation. -->
        <wpf:WebView2 x:Name="WebView"
                      x:FieldModifier="public"
                      Margin="0"
                      DefaultBackgroundColor="White"/>

    </Grid>

</UserControl>