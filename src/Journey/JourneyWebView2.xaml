<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Journey"
             xmlns:resources="clr-namespace:Journey.Resources"
             xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="480"
             d:DesignWidth="800"
             x:Class="Journey.JourneyWebView2"
             x:Name="JourneyWebView2Root"
             Background="Transparent">

    <UserControl.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Journey;component/Resources/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="Button">

                <Setter Property="Background"
                        Value="Transparent" />

                <Setter Property="Height"
                        Value="30" />

                <Setter Property="Width"
                        Value="30" />

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">

                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="3"
                                    SnapsToDevicePixels="true">

                                <ContentPresenter x:Name="contentPresenter"
                                                  Focusable="False"
                                                  HorizontalAlignment="Center"
                                                  Margin="0"
                                                  RecognizesAccessKey="True"
                                                  SnapsToDevicePixels="True"
                                                  VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="true">

                                    <Setter Property="Background"
                                            TargetName="border"
                                            Value="{DynamicResource ActiveBorderBrush}"/>

                                </Trigger>

                                <Trigger Property="IsPressed"
                                         Value="true">

                                    <Setter Property="Background"
                                            TargetName="border"
                                            Value="{DynamicResource PressedBrush}"/>

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Image" x:Key="ButtonBar">

                <Setter Property="Height"
                        Value="20" />

                <Setter Property="Opacity"
                        Value="1"/>

                <Setter Property="Width"
                        Value="20" />

                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}"
                                 Value="False">

                        <Setter Property="Opacity"
                                Value="0.4"/>

                    </DataTrigger>
                </Style.Triggers>

            </Style>

        </ResourceDictionary>

    </UserControl.Resources>

    <UserControl.CommandBindings>

        <CommandBinding Command="{x:Static local:JourneyWebView2.HideJourneyCommand}"
                        Executed="ExecuteHideJourneyCommand" />

        <CommandBinding Command="{x:Static local:JourneyWebView2.ResetJourneyViewCommand}"
                        Executed="ExecuteResetViewCommand" />

        <CommandBinding Command="{x:Static local:JourneyWebView2.ResetJourneyZoomCommand}"
                        Executed="ExecuteResetZoomCommand" />

        <CommandBinding Command="{x:Static local:JourneyWebView2.ZoomInJourneyCommand}"
                        Executed="ExecuteZoomInCommand"
                        CanExecute="CanExecuteZoomInCommand" />

        <CommandBinding Command="{x:Static local:JourneyWebView2.ZoomOutJourneyCommand}"
                        Executed="ExecuteZoomOutCommand"
                        CanExecute="CanExecuteZoomOutCommand" />

    </UserControl.CommandBindings>

    <UserControl.InputBindings>

        <KeyBinding Key="Backspace"
                    Modifiers="Control"
                    Command="{x:Static local:JourneyWebView2.ResetJourneyViewCommand}" />

        <KeyBinding Key="D0"
                    Modifiers="Control"
                    Command="{x:Static local:JourneyWebView2.ResetJourneyZoomCommand}" />

        <KeyBinding Key="Esc"
                    Command="{x:Static local:JourneyWebView2.HideJourneyCommand}" />

        <KeyBinding Key="OemPlus"
                    Modifiers="Control"
                    Command="{x:Static local:JourneyWebView2.ZoomInJourneyCommand}" />

        <KeyBinding Key="OemMinus"
                    Modifiers="Control"
                    Command="{x:Static local:JourneyWebView2.ZoomOutJourneyCommand}" />

    </UserControl.InputBindings>

    <!-- Root Grid -->
    <!-- A root grid to contain both the Journey controls and the WebView2 instance. -->
    <Grid x:Name="RootGrid"
          Background="Transparent"
          ClipToBounds="True"
          MouseDown="RootGrid_MouseDown"
          PreviewMouseMove="RootGrid_PreviewMouseMove"
          PreviewMouseUp="RootGrid_PreviewMouseUp"
          PreviewMouseWheel="RootGrid_PreviewMouseWheel">

        <!-- Journey Container -->
        <!-- Journey controls (canvas and toolbar) are within this grid to make it easy to control their visibility. -->
        <Grid x:Name="JourneyContainer"
              Background="{DynamicResource JourneyBackground}"
              Visibility="Collapsed">

            <!-- Journey Canvas -->
            <!-- This is where "Journey Steps" are presented -->
            <Canvas x:Name="JourneyCanvas"
                    Background="Transparent"
                    Focusable="True">

                <Canvas.RenderTransform>
                    <TransformGroup>

                        <ScaleTransform ScaleX="{Binding ElementName=JourneyWebView2Root, Path=JourneyZoomFactor, Mode=OneWay}"
                                        ScaleY="{Binding ElementName=JourneyWebView2Root, Path=JourneyZoomFactor, Mode=OneWay}" />

                        <TranslateTransform x:Name="JourneyCanvasTranslateTransform" />

                    </TransformGroup>
                </Canvas.RenderTransform>

            </Canvas>

            <!-- Button Bar -->
            <Border x:Name="JourneyButtonBar"
                    Background="{DynamicResource WindowBrush}"
                    BorderBrush="{DynamicResource ActiveBorderBrush}"
                    BorderThickness="1.25"
                    CornerRadius="10"
                    HorizontalAlignment="Center"
                    Margin="0,25,0,0"
                    Opacity="0"
                    Padding="10,5"
                    VerticalAlignment="Top">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Zoom Out Button -->
                    <Button x:Name="ZoomOutButton"
                            Grid.Column="0"
                            Command="{x:Static local:JourneyWebView2.ZoomOutJourneyCommand}"
                            ToolTip="{x:Static resources:Strings.JourneyWebView2_ZoomOut_ToolTip}">

                        <Image Source="{DynamicResource ZoomOutImage}"
                               Style="{StaticResource ButtonBar}" />

                    </Button>

                    <!-- Zoom In Button -->
                    <Button x:Name="ZoomInButton"
                            Grid.Column="2"
                            Command="{x:Static local:JourneyWebView2.ZoomInJourneyCommand}"
                            ToolTip="{x:Static resources:Strings.JourneyWebView2_ZoomIn_ToolTip}">

                        <Image Source="{DynamicResource ZoomInImage}"
                               Style="{StaticResource ButtonBar}" />

                    </Button>

                    <!-- Reset Zoom Button -->
                    <Button x:Name="ResetZoomButton"
                            Grid.Column="4"
                            Command="{x:Static local:JourneyWebView2.ResetJourneyZoomCommand}"
                            ToolTip="{x:Static resources:Strings.JourneyWebView2_ResetZoomLevel_ToolTip}">

                        <Image Source="{DynamicResource ResetZoomImage}"
                               Style="{StaticResource ButtonBar}" />

                    </Button>

                    <!-- Separator -->
                    <Line Grid.Column="6"
                          Stroke="{DynamicResource LineBrush}"
                          StrokeThickness="1"
                          X1="0"
                          X2="0"
                          Y1="5"
                          Y2="25" />

                    <!-- Reset View Button -->
                    <Button x:Name="ResetViewButton"
                            Grid.Column="8"
                            Command="{x:Static local:JourneyWebView2.ResetJourneyViewCommand}"
                            ToolTip="{x:Static resources:Strings.JourneyWebView2_ResetView_ToolTip}">

                        <Image Source="{DynamicResource ResetViewImage}"
                               Style="{StaticResource ButtonBar}" />

                    </Button>

                </Grid>

            </Border>

        </Grid>

        <!-- WebView -->
        <!-- This is the browser used for navigation. -->
        <wpf:WebView2 x:Name="WebView"
                     Margin="0"
                     AllowExternalDrop="{Binding AllowExternalDrop, RelativeSource={RelativeSource AncestorType=local:JourneyWebView2}, Mode=TwoWay}"
                     CreationProperties="{Binding CreationProperties, RelativeSource={RelativeSource AncestorType=local:JourneyWebView2}, Mode=TwoWay}"
                     DefaultBackgroundColor="{Binding DefaultBackgroundColor, RelativeSource={RelativeSource AncestorType=local:JourneyWebView2}, Mode=TwoWay}"
                     DesignModeForegroundColor="{Binding DesignModeForegroundColor, RelativeSource={RelativeSource AncestorType=local:JourneyWebView2}, Mode=TwoWay}"
                     Source="{Binding Source, RelativeSource={RelativeSource AncestorType=local:JourneyWebView2}, Mode=TwoWay}"
                     ZoomFactor="{Binding ZoomFactor, RelativeSource={RelativeSource AncestorType=local:JourneyWebView2}, Mode=TwoWay}"/>

    </Grid>

</UserControl>