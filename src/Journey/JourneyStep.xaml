<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:journey="clr-namespace:Journey"
             xmlns:themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.AeroLite"
             x:Class="Journey.JourneyStep"
             x:ClassModifier="internal"
             x:Name="ControlRoot"
             mc:Ignorable="d"
             d:DesignHeight="90"
             d:DesignWidth="160">

    <UserControl.DataContext>
        <journey:JourneyEntry/>
    </UserControl.DataContext>

    <themes:SystemDropShadowChrome CornerRadius="8">
        <Grid Background="White">

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Use a VisualBrush as a mask to clip the border rounded corners -->
            <Grid.OpacityMask>
                <VisualBrush Visual="{Binding ElementName=BorderMask}"/>
            </Grid.OpacityMask>

            <!-- The border used as a mask to clip rounded corners -->
            <Border Name="BorderMask"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Background="White"
                    CornerRadius="8"/>

            <!-- Snapshot Area -->
            <Image x:Name="SnapshotImage"
                   Grid.Row="0"
                   Grid.RowSpan="2"
                   Source="{Binding Snapshot}"
                   Stretch="UniformToFill"/>

            <!-- Text Area -->
            <Border x:Name="TextArea"
                    x:FieldModifier="public"
                    Grid.Row="1"
                    Background="{DynamicResource WindowBrush}"
                    BorderThickness="0"
                    Opacity="0.9">

                <Viewbox HorizontalAlignment="Left"
                         Stretch="UniformToFill">

                    <Grid Margin="5">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Entry Page Title -->
                        <TextBlock Grid.Row="0"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   MaxHeight="40"
                                   Padding="5"
                                   Text="{Binding Title}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Width="384"/>

                        <!-- Entry Page URL -->
                        <TextBlock Grid.Row="2"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextLightBrush}"
                                   Height="25"
                                   Padding="5"
                                   Text="{Binding Url}"
                                   TextWrapping="NoWrap"
                                   Width="384"/>

                    </Grid>

                </Viewbox>

            </Border>

            <Grid x:Name="HoverGrid"
                  Background="Transparent"
                  Grid.Row="0"
                  Grid.RowSpan="2">

                <Grid.Style>
                    <Style TargetType="Grid">

                        <Setter Property="Visibility"
                                Value="Collapsed"/>

                        <Style.Triggers>

                            <MultiDataTrigger>

                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Grid}}}" Value="True"/>
                                    <Condition Binding="{Binding ElementName=ControlRoot,Path=IsAnimating}" Value="False"/>
                                </MultiDataTrigger.Conditions>

                                <Setter Property="Visibility"
                                        Value="Visible"/>
                                
                                <Setter Property="Cursor"
                                        Value="Hand"/>

                            </MultiDataTrigger>

                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid Opacity="0.75">

                    <Grid.Style>
                        <Style TargetType="Grid">

                            <Setter Property="Background"
                                    Value="{DynamicResource HighlightBrush}"/>

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding Path=Type}"
                                             Value="ArchivedStep">

                                    <Setter Property="Background"
                                            Value="{DynamicResource WindowBrush}"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>
                    </Grid.Style>

                </Grid>

                <Label FontSize="28"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">

                    <Label.Style>
                        <Style TargetType="Label"
                               BasedOn="{StaticResource {x:Type Label}}">

                            <Setter Property="Foreground"
                                    Value="{DynamicResource HighlightTextBrush}"/>

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding Path=Type}"
                                             Value="ArchivedStep">
                                    
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <TextBlock TextAlignment="Center">
                                                <Run Text="⧉"/>
                                                <LineBreak/>
                                                <Run Text="Open in new tab"/>
                                            </TextBlock>
                                        </Setter.Value>
                                    </Setter>

                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextBrush}"/>

                                </DataTrigger>

                                <DataTrigger Binding="{Binding Path=Type}"
                                             Value="HistoryBack">

                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <TextBlock TextAlignment="Center">
                                                <Run Text="←"/>
                                                <LineBreak/>
                                                <Run Text="Go back"/>
                                            </TextBlock>
                                        </Setter.Value>
                                    </Setter>

                                </DataTrigger>

                                <DataTrigger Binding="{Binding Path=Type}"
                                             Value="HistoryForward">

                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <TextBlock TextAlignment="Center">
                                                <Run Text="→"/>
                                                <LineBreak/>
                                                <Run Text="Go forward"/>
                                            </TextBlock>
                                        </Setter.Value>
                                    </Setter>

                                </DataTrigger>

                                <DataTrigger Binding="{Binding Path=Type}"
                                             Value="ActiveStep">

                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <TextBlock TextAlignment="Center">
                                                <Run Text="↩"/>
                                                <LineBreak/>
                                                <Run Text="Continue"/>
                                            </TextBlock>
                                        </Setter.Value>
                                    </Setter>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>
                    </Label.Style>

                </Label>

            </Grid>

        </Grid>
    </themes:SystemDropShadowChrome>

</UserControl>