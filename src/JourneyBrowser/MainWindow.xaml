<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JourneyBrowser"
        xmlns:converters="clr-namespace:JourneyBrowser.Converters"
        xmlns:models="clr-namespace:JourneyBrowser.Models"
        xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d"
        x:Class="JourneyBrowser.MainWindow"
        x:Name="WindowRoot"
        Background="Transparent"
        Closing="Window_Closing"
        Height="720"
        Loaded="Window_Loaded"
        MinHeight="295"
        MinWidth="640"
        Title="Journey Browser"
        Width="1280"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="35"
                      ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}"
                      GlassFrameThickness="-1"/>
    </WindowChrome.WindowChrome>

    <Window.CommandBindings>

        <CommandBinding Command="{x:Static local:MainWindow.BackCommand}"
                        Executed="ExecutedBackCommand"
                        CanExecute="CanExecuteBackCommand" />

        <CommandBinding Command="{x:Static local:MainWindow.CloseTabCommand}"
                        Executed="ExecutedCloseTabCommand" />

        <CommandBinding Command="{x:Static local:MainWindow.ForwardCommand}"
                        Executed="ExecutedForwardCommand"
                        CanExecute="CanExecuteForwardCommand" />

        <CommandBinding Command="{x:Static local:MainWindow.HomeCommand}"
                        Executed="ExecutedHomeCommand" />

        <CommandBinding Command="{x:Static local:MainWindow.JourneyCommand}"
                        Executed="ExecutedJourneyCommand"
                        CanExecute="CanExecuteJourneyCommand" />

        <CommandBinding Command="{x:Static local:MainWindow.NewTabCommand}"
                        Executed="ExecutedNewTabCommand" />

        <CommandBinding Command="{x:Static local:MainWindow.RefreshCommand}"
                        Executed="ExecutedRefreshCommand" />

    </Window.CommandBindings>

    <Window.InputBindings>

        <KeyBinding Key="Left"
                    Modifiers="Alt"
                    Command="{x:Static local:MainWindow.BackCommand}" />

        <KeyBinding Key="F4"
                    Modifiers="Control"
                    Command="{x:Static local:MainWindow.CloseTabCommand}" />

        <KeyBinding Key="Right"
                    Modifiers="Alt"
                    Command="{x:Static local:MainWindow.ForwardCommand}" />

        <KeyBinding Key="Home"
                    Modifiers="Alt"
                    Command="{x:Static local:MainWindow.HomeCommand}" />

        <KeyBinding Key="J"
                    Modifiers="Alt"
                    Command="{x:Static local:MainWindow.JourneyCommand}" />

        <KeyBinding Key="T"
                    Modifiers="Control"
                    Command="{x:Static local:MainWindow.NewTabCommand}" />

        <KeyBinding Key="R"
                    Modifiers="Control"
                    Command="{x:Static local:MainWindow.RefreshCommand}" />

        <KeyBinding Key="F5"
                    Command="{x:Static local:MainWindow.RefreshCommand}" />

    </Window.InputBindings>

    <Window.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/Themes/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Resources/Themes/Theme.light.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:FriendlyUrlConverter x:Key="FriendlyUrlConverter"/>

            <!-- Root Grid Style -->
            <!-- Used to set our margin when the window maximises, as we have extended into the window chrome. -->
            <Style TargetType="Grid"
                   x:Key="WindowStyle">

                <Setter Property="Margin"
                        Value="0" />

                <Style.Triggers>
                    <DataTrigger Binding="{Binding ElementName=WindowRoot, Path=WindowState}"
                                 Value="Maximized">

                        <Setter Property="Margin"
                                Value="8,2,8,8" />

                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Button Style -->
            <!-- Explicit style for all buttons. -->
            <Style TargetType="Button"
                   x:Key="ButtonStyle">

                <Setter Property="Background"
                        Value="{DynamicResource ButtonNormalBrush}" />

                <Setter Property="Height"
                        Value="30" />

                <Setter Property="Width"
                        Value="30" />

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">

                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="3"
                                    SnapsToDevicePixels="true">

                                <ContentPresenter x:Name="contentPresenter"
                                                  Focusable="False"
                                                  HorizontalAlignment="Center"
                                                  Margin="0"
                                                  RecognizesAccessKey="True"
                                                  SnapsToDevicePixels="True"
                                                  VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="true">

                                    <Setter Property="Background"
                                            TargetName="ButtonBorder"
                                            Value="{DynamicResource ButtonHoverBrush}" />

                                </Trigger>

                                <Trigger Property="IsPressed"
                                         Value="true">

                                    <Setter Property="Background"
                                            TargetName="ButtonBorder"
                                            Value="{DynamicResource ButtonPressedBrush}" />

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

            </Style>

            <!-- Image Style -->
            <!-- Explicit style for images within buttons. -->
            <Style TargetType="Image"
                   x:Key="ButtonImageStyle">

                <Setter Property="Height"
                        Value="24" />

                <Setter Property="Opacity"
                        Value="1"/>

                <Setter Property="Width"
                        Value="24" />

                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}"
                                 Value="False">

                        <Setter Property="Opacity"
                                Value="0.4"/>

                    </DataTrigger>
                </Style.Triggers>

            </Style>

            <Style TargetType="TextBox"
                   x:Key="AddressBarStyle">

                <Setter Property="AllowDrop"
                        Value="true" />

                <Setter Property="KeyboardNavigation.TabNavigation"
                        Value="None" />

                <Setter Property="Border.BorderBrush"
                        Value="Transparent" />

                <Setter Property="FontFamily"
                        Value="{StaticResource RobotoRegular}" />

                <Setter Property="FontSize"
                        Value="14" />

                <Setter Property="Height"
                        Value="36" />

                <Setter Property="HorizontalAlignment"
                        Value="Stretch" />

                <Setter Property="MaxWidth"
                        Value="1000" />

                <Setter Property="OverridesDefaultStyle"
                        Value="True" />

                <Setter Property="SnapsToDevicePixels"
                        Value="True" />

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">

                            <Border Name="TextBoxBorder"
                                    Background="{DynamicResource AddressBarBackgroundNormalBrush}"
                                    BorderBrush="Transparent"
                                    BorderThickness="2"
                                    CornerRadius="6">

                                <VisualStateManager.VisualStateGroups>

                                    <VisualStateGroup x:Name="CommonStates">

                                        <VisualState x:Name="Normal" />

                                        <VisualState x:Name="Focused">
                                            <Storyboard>

                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TextBoxBorder"
                                                                               Storyboard.TargetProperty="Background">

                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{DynamicResource AddressBarBackgroundFocusedBrush}" />

                                                </ObjectAnimationUsingKeyFrames>

                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TextBoxBorder"
                                                                               Storyboard.TargetProperty="BorderBrush">

                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{StaticResource HighlightBrush}" />

                                                </ObjectAnimationUsingKeyFrames>

                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_ContentHost"
                                                                               Storyboard.TargetProperty="Visibility">

                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{x:Static Visibility.Visible}" />

                                                </ObjectAnimationUsingKeyFrames>

                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ShortUrlLabel"
                                                                               Storyboard.TargetProperty="Visibility">

                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{x:Static Visibility.Collapsed}" />

                                                </ObjectAnimationUsingKeyFrames>

                                            </Storyboard>
                                        </VisualState>

                                    </VisualStateGroup>

                                </VisualStateManager.VisualStateGroups>

                                <Grid>

                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Margin="5"
                                                  VerticalAlignment="Center"
                                                  Visibility="Hidden" />

                                    <TextBlock x:Name="ShortUrlLabel"
                                               Background="Transparent"
                                               Foreground="{Binding ElementName=PART_ContentHost, Path=Foreground}"
                                               HorizontalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Margin="{Binding ElementName=PART_ContentHost, Path=Margin}"
                                               Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource FriendlyUrlConverter}}"
                                               VerticalAlignment="Center"
                                               Visibility="Visible"/>

                                </Grid>

                            </Border>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

                <Style.Triggers>

                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Border}}}"
                                       Value="True">

                        <Setter Property="Cursor"
                                Value="IBeam"/>

                    </DataTrigger>

                </Style.Triggers>

            </Style>

            <!-- TabControl Style -->
            <!-- Implicit style for our browser tab control. -->
            <Style TargetType="TabControl">

                <Setter Property="OverridesDefaultStyle"
                        Value="True" />

                <Setter Property="SnapsToDevicePixels"
                        Value="True" />

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Tabs -->
                                <DockPanel Grid.Row="0"
                                           LastChildFill="False"
                                           Margin="12,7,150,0">

                                    <!-- Tab Panel -->
                                    <TabPanel x:Name="TabPanel"
                                              Background="Transparent"
                                              IsItemsHost="True"
                                              Margin="0"
                                              Panel.ZIndex="1"/>

                                    <!-- New Tab Button -->
                                    <Button x:Name="NewTabButton"
                                            Command="{x:Static local:MainWindow.NewTabCommand}"
                                            Content="+"
                                            Height="28"
                                            Margin="2,0,0,0"
                                            VerticalAlignment="Center"
                                            Width="28"/>

                                </DockPanel>

                                <!-- Button Bar -->
                                <Border x:Name="ButtonBar"
                                        Grid.Row="1"
                                        Background="White"
                                        BorderBrush="LightGray"
                                        BorderThickness="0,0,0,1"
                                        Padding="10,6">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition MinWidth="180" MaxWidth="230" />
                                            <ColumnDefinition Width="*" MinWidth="300" />
                                            <ColumnDefinition MaxWidth="230" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Navigation Buttons -->
                                        <Grid Grid.Column="0">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="5"/>
                                                <ColumnDefinition Width="1"/>
                                                <ColumnDefinition Width="5"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="5"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="5"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="5"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Home Button -->
                                            <Button x:Name="HomeButton"
                                                    Grid.Column="0"
                                                    Command="{x:Static local:MainWindow.HomeCommand}"
                                                    Style="{StaticResource ButtonStyle}" >
                                                <!-- ToolTip="{x:Static resources:Strings.Home}"> -->

                                                <Image Source="{DynamicResource HomeImage}"
                                                       Style="{StaticResource ButtonImageStyle}" />

                                            </Button>

                                            <!-- Separator -->
                                            <Line Grid.Column="2"
                                                  SnapsToDevicePixels="True"
                                                  Stroke="{DynamicResource SeparatorBrush}"
                                                  StrokeThickness="1"
                                                  X1="0"
                                                  X2="0"
                                                  Y1="5"
                                                  Y2="25" />

                                            <!-- Back Button -->
                                            <Button x:Name="BackButton"
                                                    Grid.Column="4"
                                                    Command="{x:Static local:MainWindow.BackCommand}"
                                                    Style="{StaticResource ButtonStyle}" >

                                                <Image Source="{DynamicResource BackImage}"
                                                       Style="{StaticResource ButtonImageStyle}" />

                                            </Button>

                                            <!-- Journey Button -->
                                            <Button x:Name="JourneyButton"
                                                    Grid.Column="6"
                                                    Command="{x:Static local:MainWindow.JourneyCommand}"
                                                    Style="{StaticResource ButtonStyle}" >

                                                <Image Source="{DynamicResource JourneyImage}"
                                                       Style="{StaticResource ButtonImageStyle}" />

                                            </Button>

                                            <!-- Forward Button -->
                                            <Button x:Name="ForwardButton"
                                                    Grid.Column="8"
                                                    Command="{x:Static local:MainWindow.ForwardCommand}"
                                                    Style="{StaticResource ButtonStyle}" >

                                                <Image Source="{DynamicResource ForwardImage}"
                                                       Style="{StaticResource ButtonImageStyle}" />

                                            </Button>

                                            <!-- Refresh Button -->
                                            <Button x:Name="RefreshButton"
                                                    Grid.Column="10"
                                                    Command="{x:Static local:MainWindow.RefreshCommand}"
                                                    Style="{StaticResource ButtonStyle}" >

                                                <Image Source="{DynamicResource RefreshImage}"
                                                       Style="{StaticResource ButtonImageStyle}" />

                                            </Button>

                                        </Grid>

                                        <!-- Address Bar -->
                                        <TextBox Name="AddressBar"
                                                 GotFocus="AddressBar_OnGotFocus"
                                                 Grid.Column="1"
                                                 Style="{StaticResource AddressBarStyle}"
                                                 Text="{Binding ElementName=WindowRoot, Path=SelectedTab.Address, Mode=TwoWay}" />

                                        <!-- Settings Button -->
                                        <Button x:Name="SettingsButton"
                                                Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource ButtonStyle}" >

                                            <Button.ContextMenu>
                                                <ContextMenu Name="SettingsButtonMenu">

                                                    <MenuItem Header="Auto"/>

                                                    <Separator />

                                                    <MenuItem Header="Light"/>

                                                    <MenuItem Header="Dark"/>

                                                </ContextMenu>
                                            </Button.ContextMenu>

                                            <Button.Triggers>
                                                <EventTrigger SourceName="SettingsButton"
                                                              RoutedEvent="Button.Click">

                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SettingsButtonMenu"
                                                                                           Storyboard.TargetProperty="IsOpen">

                                                                <DiscreteObjectKeyFrame KeyTime="0:0:0">
                                                                    <DiscreteObjectKeyFrame.Value>
                                                                        <system:Boolean>True</system:Boolean>
                                                                    </DiscreteObjectKeyFrame.Value>
                                                                </DiscreteObjectKeyFrame>

                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </BeginStoryboard>

                                                </EventTrigger>
                                            </Button.Triggers>

                                            <Image Source="{DynamicResource DarkModeImage}"
                                                   Style="{StaticResource ButtonImageStyle}" />

                                        </Button>

                                    </Grid>
                                </Border>

                                <ContentPresenter x:Name="SelectedContent"
                                                  Grid.Row="2"
                                                  ContentSource="SelectedContent" />

                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

            </Style>

            <!-- TabItem Style -->
            <!-- Implicit style for our browser tabs. -->
            <Style TargetType="TabItem">

                <Setter Property="Background"
                        Value="{DynamicResource TabInactiveBrush}"/>

                <Setter Property="HorizontalAlignment"
                        Value="Left" />

                <Setter Property="Margin"
                        Value="0"/>

                <Setter Property="MaxWidth"
                        Value="200"/>

                <Setter Property="MinWidth"
                        Value="50"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">

                            <Border Name="TabItemBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="0"
                                    CornerRadius="6,6,0,0"
                                    Height="31"
                                    HorizontalAlignment="Stretch"
                                    Margin="0"
                                    Padding="5,3">

                                <ContentPresenter x:Name="TabItemContent"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  ContentSource="Header"/>

                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsSelected"
                                         Value="True">

                                    <Setter TargetName="TabItemBorder"
                                            Property="Background"
                                            Value="{DynamicResource TabActiveBrush}" />

                                </Trigger>

                                <MultiTrigger>

                                    <MultiTrigger.Conditions>

                                        <Condition Property="IsMouseOver"
                                                   Value="True"/>

                                        <Condition Property="IsSelected"
                                                   Value="False"/>

                                    </MultiTrigger.Conditions>

                                    <Setter TargetName="TabItemBorder"
                                            Property="Background"
                                            Value="{DynamicResource TabHoverBrush}" />

                                </MultiTrigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>

    </Window.Resources>

    <Grid Style="{StaticResource WindowStyle}">

        <TabControl x:Name="BrowserTabControl"
                    IsSynchronizedWithCurrentItem="True"
                    ItemsSource="{Binding ElementName=WindowRoot, Path=Tabs}"
                    SelectedItem="{Binding ElementName=WindowRoot, Path=SelectedTab, Mode=TwoWay}"
                    SelectedIndex="{Binding ElementName=WindowRoot, Path=SelectedIndex, Mode=TwoWay}"
                    WindowChrome.IsHitTestVisibleInChrome="True">

            <TabControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:BrowserTab}">
                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="{Binding Title}"
                                   HorizontalAlignment="Stretch" />

                        <Button Content="✕"
                                Command="{x:Static local:MainWindow.CloseTabCommand}"
                                CommandParameter="{Binding}"
                                Height="16"
                                Margin="3,0,0,0"
                                Padding="0"
                                Style="{StaticResource ButtonStyle}"
                                ToolTip="Close Tab"
                                VerticalAlignment="Center"
                                Width="16" />

                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <TabControl.ContentTemplate>
                <DataTemplate DataType="{x:Type models:BrowserTab}">

                    <wpf:WebView2 x:Name="WebView"
                                  Source="{Binding Address, Mode=TwoWay}" />

                </DataTemplate>
            </TabControl.ContentTemplate>

        </TabControl>

    </Grid>

</Window>