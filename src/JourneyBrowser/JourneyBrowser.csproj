<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net9.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<RootNamespace>JourneyBrowser</RootNamespace>
		<AssemblyName>JourneyBrowser</AssemblyName>
		<AssemblyTitle>Journey Browser</AssemblyTitle>
		<StartupObject>Journey.App</StartupObject>
		<ApplicationIcon>Resources\Icons\journey.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Resources\**\*" />
	</ItemGroup>

	<!-- Fonts -->
	<ItemGroup>
		<Resource Include="Resources\Fonts\**\*">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Resource>
	</ItemGroup>

	<!-- Icons -->
	<ItemGroup>
		<Content Include="Resources\Icons\journey.ico" />
	</ItemGroup>

	<!-- Images -->
	<ItemGroup>
		<Resource Include="Resources\Images\**\*">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Resource>
	</ItemGroup>

	<!-- Strings -->
	<ItemGroup>
		<Compile Update="Resources\Strings\Strings.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Strings.resx</DependentUpon>
		</Compile>
		<EmbeddedResource Update="Resources\Strings\Strings.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Strings.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<!-- Projects -->
	<ItemGroup>
		<ProjectReference Include="..\Journey\Journey.csproj" />
	</ItemGroup>

	<!-- Packages -->
	<ItemGroup>
		<PackageReference Include="ModernWpfUI" Version="0.9.5" />
	</ItemGroup>

</Project>