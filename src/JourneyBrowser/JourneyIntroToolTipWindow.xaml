<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wpf="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
        mc:Ignorable="d"
        x:Class="JourneyBrowser.JourneyIntroToolTipWindow"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        Height="420"
        ShowInTaskbar="False"
        WindowStyle="None"
        Width="320">

    <Window.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/Themes/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Resources/Themes/Theme.light.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>

    </Window.Resources>

    <Grid>

        <Path Fill="{StaticResource ShellBrush}"
              Stroke="{StaticResource ShellBorderBrush}"
              StrokeThickness="1">

            <Path.Data>
                <CombinedGeometry GeometryCombineMode="Union">

                    <CombinedGeometry.Geometry1>

                        <RectangleGeometry Rect="10,15,300,385"
                                           RadiusX="12"
                                           RadiusY="12"/>

                    </CombinedGeometry.Geometry1>

                    <CombinedGeometry.Geometry2>
                        <PathGeometry>

                            <PathFigure StartPoint="30,15"
                                        IsClosed="True">

                                <LineSegment Point="30,15"/>
                                <LineSegment Point="45,0"/>
                                <LineSegment Point="60,15"/>

                            </PathFigure>

                        </PathGeometry>
                    </CombinedGeometry.Geometry2>
                </CombinedGeometry>
            </Path.Data>

            <Path.Effect>

                <DropShadowEffect BlurRadius="8"
                                  Color="{DynamicResource ShadowColor}"
                                  Direction="315"
                                  ShadowDepth="5"/>

            </Path.Effect>
        </Path>

        <Grid Margin="30,10,30,30">

            <Grid.RowDefinitions>
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <wpf:LottieAnimationView Grid.Row="1"
                                     AutoPlay="True"
                                     Height="280"
                                     HorizontalAlignment="Stretch"
                                     RepeatCount="-1"
                                     ResourcePath="pack://application:,,,/Resources/Animations/journey_intro.json"
                                     VerticalAlignment="Stretch"
                                     Width="280"/>

            <TextBlock Grid.Row="2" 
                       FontSize="16"
                       Text="This is a custom window!" />

        </Grid>

    </Grid>

</Window>