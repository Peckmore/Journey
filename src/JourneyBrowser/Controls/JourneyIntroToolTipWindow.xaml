<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:resources="clr-namespace:JourneyBrowser.Resources"
        xmlns:wpf="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
        mc:Ignorable="d"
        x:Class="JourneyBrowser.Controls.JourneyIntroToolTipWindow"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        Height="420"
        ShowInTaskbar="False"
        Width="320"
        WindowStyle="None">

    <Window.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/Themes/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Resources/Themes/Theme.light.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>

    </Window.Resources>

    <Grid>

        <Path Fill="{StaticResource ShellBrush}"
              Stroke="{StaticResource ShellBorderBrush}"
              StrokeThickness="1">

            <Path.Data>
                <CombinedGeometry GeometryCombineMode="Union">

                    <CombinedGeometry.Geometry1>

                        <RectangleGeometry Rect="10,15,300,360"
                                           RadiusX="12"
                                           RadiusY="12"/>

                    </CombinedGeometry.Geometry1>

                    <CombinedGeometry.Geometry2>
                        <PathGeometry>

                            <PathFigure StartPoint="30,15"
                                        IsClosed="True">

                                <LineSegment Point="30,15"/>
                                <LineSegment Point="45,0"/>
                                <LineSegment Point="60,15"/>

                            </PathFigure>

                        </PathGeometry>
                    </CombinedGeometry.Geometry2>
                </CombinedGeometry>
            </Path.Data>

            <Path.Effect>

                <DropShadowEffect BlurRadius="8"
                                  Color="{DynamicResource ShadowColor}"
                                  Direction="315"
                                  ShadowDepth="5"/>

            </Path.Effect>
        </Path>

        <Grid Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="210" />
                <RowDefinition Height="125" />
            </Grid.RowDefinitions>

            <wpf:LottieAnimationView Grid.Row="0"
                                     AutoPlay="True"
                                     Height="210"
                                     HorizontalAlignment="Stretch"
                                     RepeatCount="-1"
                                     ResourcePath="pack://application:,,,/Resources/Animations/journey_intro.json"
                                     VerticalAlignment="Top" />

            <TextBlock Grid.Row="1"
                       FontFamily="{StaticResource RobotoRegular}"
                       FontSize="14"
                       Foreground="{StaticResource ShellTextBrush}"
                       TextWrapping="Wrap">

                <Run Text="{x:Static resources:Strings.JourneyIntro_Title}" />

                <LineBreak/><LineBreak/>

                <Run Text="{x:Static resources:Strings.JourneyIntro_Text}" />

                <LineBreak/><LineBreak/>

                <Hyperlink Click="Hyperlink_RequestNavigate"
                           TextDecorations="None">

                    <TextBlock Foreground="{StaticResource HighlightBrush}"
                               Text="{x:Static resources:Strings.JourneyIntro_GotIt}"
                               TextAlignment="Center" />

                </Hyperlink>

            </TextBlock>

        </Grid>

    </Grid>

</Window>